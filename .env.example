# Copy to .env and fill in. Never commit .env.

# Discord bot token (Developer Portal -> your app -> Bot -> Reset Token)
DISCORD_TOKEN=

# REQUIRED. Comma-separated Discord user IDs allowed to use the bot.
# Anyone not listed is ignored, because the bot drives YOUR DeepSeek account.
ALLOWED_USER_IDS=

# Optional: also answer every message from allowed users in this channel (no @mention needed)
CHANNEL_ID=

# Browser. "chrome" uses your installed Chrome (no download). Leave blank to use
# Playwright's bundled Chromium (run: npx playwright install chromium)
BROWSER_CHANNEL=chrome
# To use Brave (or any other Chromium browser) set the full path to its executable; this overrides BROWSER_CHANNEL.
#   Windows: C:\Program Files\BraveSoftware\Brave-Browser\Application\brave.exe
#   macOS:   /Applications/Brave Browser.app/Contents/MacOS/Brave Browser
#   Linux:   /usr/bin/brave-browser
BROWSER_PATH=
# Recommended if you hit captchas: attach to a Brave you start yourself with --remote-debugging-port=9222
# (see README). When set, BROWSER_PATH / PROFILE_DIR / HEADLESS are not used.
CDP_URL=
# Folder where the logged-in browser profile is stored
PROFILE_DIR=./profile
# true = no visible window. Start with false; headless is more likely to hit bot checks.
HEADLESS=false

# Start a fresh DeepSeek chat after this many messages (keeps context from filling up). 0 = never
AUTO_NEW_EVERY=40
# Reply is considered finished after the text stops changing for this long (ms)
STABLE_MS=5000
# Give up on a reply after this long (ms)
REPLY_TIMEOUT_MS=240000

# Selectors. DeepSeek changes its UI often; if the bot stops working, fix these first.
INPUT_SELECTOR=textarea
REPLY_SELECTOR=.ds-markdown
